# {{ ansible_managed }}
FROM {{ base_image }}

# RHEL content comes from the *build host's* entitlement:
#   - registered RHEL host: podman passes /run/secrets through automatically
#   - any other host (e.g. Fedora): the playbook mounts rhsm_secrets_dir at /run/secrets
# subscription-manager is not usable inside a container build, so enable the
# extensions repo per-transaction instead.
RUN dnf install -y --enablerepo="rhel-10-for-$(arch)-extensions-rpms" \
        goose-redhat \
        insights-client{% for pkg in extra_packages %} \
        {{ pkg }}{% endfor %} && \
    dnf clean all

# Guarantee the image uses the RHEL command-line assistant backend: goose-redhat
# ships a config selecting the rhel_cla provider, which talks to goose-proxy
# (socket-activated on 127.0.0.1:7080). Fail the build if any of that changes.
RUN rpm -q goose-redhat goose-proxy && \
    grep -qx 'GOOSE_PROVIDER: rhel_cla' /usr/share/goose-redhat/config.yaml && \
    grep -qx 'GOOSE_MODEL: RHEL-command-line-assistant' /usr/share/goose-redhat/config.yaml && \
    test -f /usr/share/goose-redhat/rhel_cla.json && \
    systemctl enable goose-proxy.socket && \
    systemctl is-enabled goose-proxy.socket

# First-boot Red Hat / Insights registration. No-op unless credentials are
# supplied at runtime (SMBIOS for KVM, /run/credstore for Podman) - nothing
# secret is baked into the image.
COPY goose-register.sh /usr/libexec/goose-register
COPY goose-register.service /usr/lib/systemd/system/goose-register.service
# Post-deploy check that goose really runs on the CLA backend (used by the playbook).
COPY goose-verify.sh /usr/libexec/goose-verify
RUN chmod 0755 /usr/libexec/goose-register /usr/libexec/goose-verify && \
    systemctl enable goose-register.service
{% if admin_sudo_nopasswd %}

# Admin user is key-only (no password), so allow wheel to sudo without one.
RUN echo '%wheel ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/90-wheel-nopasswd && \
    chmod 0440 /etc/sudoers.d/90-wheel-nopasswd
{% endif %}

RUN bootc container lint
